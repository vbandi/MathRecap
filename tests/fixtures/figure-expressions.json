{
  "description": "Function-plot expressions shared by the JS and C# figure-expression tests. A valid case lists [x, expected] samples; expected values match within 1e-9, and null means the result is not a finite number. Invalid cases must be rejected.",
  "valid": [
    { "expression": "0.5*x^2 - 2", "samples": [[2, 0], [0, -2], [-4, 6]] },
    { "expression": "2x^2 - 3", "samples": [[2, 5], [0, -3]] },
    { "expression": "-x^2", "samples": [[3, -9]] },
    { "expression": "-2^2", "samples": [[0, -4]] },
    { "expression": "2^-x", "samples": [[2, 0.25]] },
    { "expression": "x^-1", "samples": [[2, 0.5], [0, null]] },
    { "expression": "2^3^2", "samples": [[0, 512]] },
    { "expression": "2^3x", "samples": [[2, 16]] },
    { "expression": "x**2", "samples": [[3, 9]] },
    { "expression": "8/2/2", "samples": [[0, 2]] },
    { "expression": "8-2-2", "samples": [[0, 4]] },
    { "expression": "(x+1)(x-1)", "samples": [[3, 8]] },
    { "expression": "2(x+1)", "samples": [[1, 4]] },
    { "expression": "+x", "samples": [[2, 2]] },
    { "expression": "  x  ", "samples": [[1, 1]] },
    { "expression": "0,5x + 1", "samples": [[4, 3]] },
    { "expression": ".5x", "samples": [[2, 1]] },
    { "expression": "3·x−2", "samples": [[2, 4]] },
    { "expression": "2×x – 1", "samples": [[3, 5]] },
    { "expression": "1/x", "samples": [[2, 0.5], [0, null]] },
    { "expression": "sqrt(x+1)", "samples": [[3, 2], [-2, null]] },
    { "expression": "abs(x) - 1", "samples": [[-4, 3]] },
    { "expression": "log(x)", "samples": [[100, 2], [0, null]] },
    { "expression": "lg(x)", "samples": [[1000, 3]] },
    { "expression": "ln(e)", "samples": [[0, 1]] },
    { "expression": "exp(x)", "samples": [[0, 1], [1, 2.718281828459045]] },
    { "expression": "ex", "samples": [[1, 2.718281828459045]] },
    { "expression": "2pi", "samples": [[0, 6.283185307179586]] },
    { "expression": "sin(pi/2)", "samples": [[0, 1]] },
    { "expression": "SIN(X)", "samples": [[0, 0]] },
    { "expression": "cos(π)", "samples": [[0, -1]] },
    { "expression": "tan(x)", "samples": [[0, 0]] },
    { "expression": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "samples": [[1, 1]] }
  ],
  "invalid": [
    { "expression": "", "reason": "empty" },
    { "expression": "   ", "reason": "blank" },
    { "expression": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "reason": "longer than 200 characters" },
    { "expression": "alert(1)", "reason": "unknown name" },
    { "expression": "constructor", "reason": "unknown name" },
    { "expression": "Math.sin(x)", "reason": "unknown name" },
    { "expression": "y + 1", "reason": "unknown variable" },
    { "expression": "(x+1", "reason": "unbalanced parentheses" },
    { "expression": "x)", "reason": "unbalanced parentheses" },
    { "expression": "()", "reason": "empty parentheses" },
    { "expression": "sin x", "reason": "function without parentheses" },
    { "expression": "sqrt", "reason": "function without argument" },
    { "expression": "sin()", "reason": "empty function argument" },
    { "expression": "x + ", "reason": "missing operand" },
    { "expression": "x^", "reason": "missing exponent" },
    { "expression": "*x", "reason": "missing operand" },
    { "expression": "x;1", "reason": "unexpected character" },
    { "expression": "x == 1", "reason": "unexpected character" }
  ]
}
